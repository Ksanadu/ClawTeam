# ========== 阶段 1 最小配置 ==========

# --- LLM：用 DeepSeek 作为主对话模型 ---
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=your_api_key_here

# --- DeepSeek 完整配置 ---
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Guardian：先关掉 ---
GUARDIAN_ENABLED=false

# --- 长期记忆：先关掉 ---
MEMORY_BACKEND=off

# === Qwen3 LoRA roles ===
USE_LORA_SURGEON=false
LORA_SURGEON_BASE=/root/autodl-tmp/Qwen3-4B-Instruct-2507
LORA_SURGEON_PATH=eval/models/surgeon_qwen3_lora

USE_LORA_MEDICAL_ONCOLOGIST=false
LORA_MEDICAL_ONCOLOGIST_BASE=/root/autodl-tmp/Qwen3-4B-Instruct-2507
LORA_MEDICAL_ONCOLOGIST_PATH=eval/models/oncologist_qwen3_lora

# --- 本机开发 HTTP 边界；非本机部署必须配置认证反向代理 ---
CLAWTEAM_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CLAWTEAM_ALLOWED_ORIGINS=http://localhost:7788,http://127.0.0.1:7788,http://[::1]:7788

# --- 有界上下文与会诊超时（秒） ---
AGENT_HISTORY_MAX_MESSAGES=20
AGENT_HISTORY_MAX_CHARS=24000
MDT_ROLE_TIMEOUT_SECONDS=120
MDT_ROUND_TIMEOUT_SECONDS=180
MDT_STAGE_TIMEOUT_SECONDS=120
